#!/usr/bin/env bash
# Toggle a workflow active/inactive via the n8n REST API.
# Usage: omarchy-n8n-toggle <instanceId> <workflowId> <true|false>
set -euo pipefail

INSTANCE_ID="${1:?Usage: omarchy-n8n-toggle <instanceId> <workflowId> <true|false>}"
WORKFLOW_ID="${2:?missing workflowId}"
ACTIVE="${3:?missing active state (true|false)}"

[[ "$INSTANCE_ID" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "Invalid instance id: $INSTANCE_ID" >&2; exit 1; }
# workflowId flows in from the n8n API response (via -fetch and the UI), so
# it must be validated before being spliced into the request URL below —
# otherwise a compromised endpoint could smuggle extra path segments to
# redirect the authenticated request to a different endpoint/verb.
[[ "$WORKFLOW_ID" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "Invalid workflow id: $WORKFLOW_ID" >&2; exit 1; }

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-n8n"
INSTANCES_FILE="$CONFIG_DIR/instances.json"

inst_url=$(jq -r --arg id "$INSTANCE_ID" '.[] | select(.id == $id) | .url' "$INSTANCES_FILE") || true
[[ -n "$inst_url" ]] || { echo "Instance not found: $INSTANCE_ID" >&2; exit 1; }
inst_url="${inst_url%/}"

# Get API key from the system keyring.
api_key=""
if command -v secret-tool >/dev/null 2>&1; then
  api_key=$(secret-tool lookup service omarchy-n8n account "$INSTANCE_ID" 2>/dev/null) || true
fi
[[ -n "$api_key" ]] || { echo "No API key for instance: $INSTANCE_ID" >&2; exit 1; }

action="activate"
[[ "$ACTIVE" == "true" ]] || action="deactivate"

tmp_body=$(mktemp)
trap 'rm -f "$tmp_body"' EXIT

# Pass the API key to curl via a -K config file read from stdin rather than
# -H/argv, so it doesn't show up in `ps`/`/proc/<pid>/cmdline` output.
escaped_key="${api_key//\\/\\\\}"
escaped_key="${escaped_key//\"/\\\"}"

http_code=$(printf 'header = "X-N8N-API-KEY: %s"\n' "$escaped_key" \
  | curl -s --max-time 8 --max-filesize 65536 -K - -X POST \
      -o "$tmp_body" -w '%{http_code}' \
      "$inst_url/api/v1/workflows/$WORKFLOW_ID/$action")
body=$(head -c 65536 "$tmp_body")

if [[ "$http_code" -ge 200 && "$http_code" -lt 300 ]]; then
  echo '{"ok":true}'
else
  err_msg=$(echo "$body" | jq -r '.message // empty' 2>/dev/null | head -c 500)
  [[ -n "$err_msg" ]] || err_msg="HTTP $http_code"
  jq -n --arg msg "$err_msg" --arg code "$http_code" \
    '{ok:false, httpCode: ($code|tonumber), message: $msg}'
  exit 1
fi
